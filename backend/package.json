{
  "name": "cineverse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CINEVERSE movie ticket booking — REST API (Express + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --reset",
    "db:seed": "node src/db/migrate.js --seed-only",
    "test": "node --test \"src/tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "zod": "^3.23.8"
  }
}
