# =============================================================================
#  CINEVERSE — environment template
#  Copy to `.env` and fill in your values:   cp .env.example .env
#  `.env` is git-ignored. Never commit real credentials.
# =============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------------------
# MySQL
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cineverse
# Set to your MySQL 8 installation's credentials. The migration runner needs an
# account that may CREATE DATABASE (schema.sql drops and recreates `cineverse`).

# ----------------------------------------------------------------------------
# Auth / security
# ----------------------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ----------------------------------------------------------------------------
# Booking rules
# ----------------------------------------------------------------------------
CONVENIENCE_FEE_PERCENT=5
BOOKING_HOLD_MINUTES=10
MAX_SEATS_PER_BOOKING=10
# The bundled payment step is a SIMULATION for demo purposes - no real money moves.
SIMULATE_PAYMENTS=true
# Optional: force a fraction of demo payments to fail, to show the failure path.
PAYMENT_FAILURE_RATE=0

# ----------------------------------------------------------------------------
# OpenRouter AI (optional)
# Without a key the booking system works normally and AI endpoints answer with a
# clear fallback message instead of failing. The key is read on the server only.
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_TOKENS=900
OPENROUTER_TEMPERATURE=0.4

# ----------------------------------------------------------------------------
# Frontend (Vite)
# ----------------------------------------------------------------------------
# Leave empty in development: Vite proxies /api to the backend (see vite.config.js).
VITE_API_BASE_URL=
